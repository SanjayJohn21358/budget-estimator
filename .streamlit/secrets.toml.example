# =============================================================================
# Streamlit Secrets Configuration
# =============================================================================
# Copy this file to secrets.toml and fill in your values.
# On Streamlit Community Cloud, paste these into the Secrets section
# of your app settings (Settings → Secrets).
#
# NEVER commit secrets.toml to version control!
# =============================================================================

# --- Google Sheets -----------------------------------------------------------

[sheets]
pricing_guide_sheet_id = ""      # The ID from your pricing guide sheet URL
output_template_sheet_id = ""    # The ID from your output template sheet URL
pricing_guide_tab_name = "Sheet1"
output_template_tab_name = "Sheet1"
estimates_sheet_id = ""          # (Optional) Sheet ID for the shared estimates workbook.
                                 # Each export adds a new tab here. Previously exported tabs
                                 # (named "Estimate - ...") can be loaded back into the UI.
                                 # If blank, exports go into the output template sheet.

# --- Google Cloud Service Account --------------------------------------------
# Create a service account in GCP console, enable the Google Sheets API,
# download the JSON key, and paste its contents below.
# Share both Google Sheets with the service account email address.

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""

# --- LLM (OpenAI) -----------------------------------------------------------
# Only needed if you want to use the Text Description mode.

[llm]
openai_api_key = ""
model_name = "gpt-4o"
temperature = 0.2

# --- Cost Overrides (optional) -----------------------------------------------
# These can also be adjusted in the app sidebar at runtime.

# [costs]
# dump_run_cost = 120.0
# labor_rate_per_hour = 120.0
# crew_size = 2
# plant_delivery_pct = 0.07
# tax_rate = 0.0875

